<UserControl
    x:Class="Openza.Reader.Shell.ReaderShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Openza.Reader.Controls"
    xmlns:pages="using:Openza.Reader.Pages"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition x:Name="InfoBarRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Image
                Width="20"
                Height="20"
                Margin="16,0,10,0"
                VerticalAlignment="Center"
                Source="Assets/Square44x44Logo.targetsize-32_altform-unplated.png" />
            <Grid
                Grid.Column="1"
                VerticalAlignment="Center"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleTextBlock"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Openza Reader"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="DocumentStatsText"
                    Grid.Column="1"
                    MaxWidth="360"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid
            x:Name="ToolbarHost"
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <CommandBar
                x:Name="ReaderCommandBar"
                DefaultLabelPosition="Bottom"
                HorizontalAlignment="Center"
                IsOpen="True"
                IsSticky="True"
                Closed="OnReaderCommandBarClosed"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open Markdown file" Click="OnOpenClicked" />
                <AppBarButton Label="Recent" ToolTipService.ToolTip="Show recent files" Click="OnRecentClicked">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Refresh" Label="Reload" ToolTipService.ToolTip="Reload current file" Click="OnReloadClicked" />
                <AppBarButton
                    x:Name="ViewModeButton"
                    Icon="View"
                    Label="View"
                    ToolTipService.ToolTip="View mode">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem
                                x:Name="PreviewModeItem"
                                GroupName="ViewMode"
                                IsChecked="True"
                                Text="Preview"
                                Click="OnPreviewModeClicked" />
                            <RadioMenuFlyoutItem
                                x:Name="RawModeItem"
                                GroupName="ViewMode"
                                Text="Raw Markdown"
                                Click="OnRawModeClicked" />
                            <RadioMenuFlyoutItem
                                x:Name="SideBySideModeItem"
                                GroupName="ViewMode"
                                Text="Side by side"
                                Click="OnSideBySideModeClicked" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarToggleButton x:Name="FocusButton" Icon="FullScreen" Label="Focus" ToolTipService.ToolTip="Toggle focus reading mode" Click="OnFocusClicked" />
                <AppBarButton x:Name="SearchButton" Icon="Find" Label="Search" ToolTipService.ToolTip="Search rendered document" Click="OnSearchClicked" />
                <AppBarButton x:Name="TocButton" Icon="List" Label="Contents" ToolTipService.ToolTip="Show or hide contents" Click="OnToggleTocClicked" />
                <AppBarSeparator />
                <AppBarButton Icon="ZoomOut" Label="Zoom out" ToolTipService.ToolTip="Zoom out" Click="OnZoomOutClicked" />
                <AppBarButton Icon="ZoomIn" Label="Zoom in" ToolTipService.ToolTip="Zoom in" Click="OnZoomInClicked" />
                <AppBarSeparator />
                <AppBarButton Icon="Copy" Label="Copy" ToolTipService.ToolTip="Copy selected text" Click="OnCopyClicked" />
                <AppBarButton Icon="Edit" Label="Editor" ToolTipService.ToolTip="Choose an installed editor" Click="OnOpenExternalClicked" />
                <AppBarSeparator />
                <AppBarButton Icon="Setting" Label="Settings" ToolTipService.ToolTip="Open settings" Click="OnSettingsClicked" />
                <AppBarButton Label="About" ToolTipService.ToolTip="About Openza Reader" Click="OnAboutClicked">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="DocumentInfoBar"
            Grid.Row="2"
            Margin="16,8,16,0"
            IsOpen="False"
            IsClosable="True" />

        <Grid x:Name="ContentRoot" Grid.Row="3" SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:TocPaneControl
                x:Name="TocPane"
                Grid.Column="0"
                Visibility="Collapsed" />

            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid x:Name="ReaderViewHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RawColumn" Width="0" />
                        <ColumnDefinition x:Name="ReaderDividerColumn" Width="0" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="RawMarkdownTextBox"
                        Grid.Column="0"
                        Margin="0"
                        Padding="24"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="RawMarkdownTextBox"
                        AutomationProperties.Name="Raw Markdown view"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="14"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />

                    <Border
                        Grid.Column="1"
                        Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <WebView2 x:Name="ReaderWebView" Grid.Column="2" />
                </Grid>

                <controls:ReaderEmptyStateControl
                    x:Name="EmptyState" />

                <Button
                    x:Name="FocusExitButton"
                    AutomationProperties.AutomationId="FocusExitButton"
                    Margin="0,16,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OnExitFocusClicked"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Exit focus mode">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE740;" />
                        <TextBlock Text="Exit focus" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                x:Name="PageWorkspace"
                Grid.ColumnSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="36,24,36,12"
                    ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CloseWorkspaceButton"
                        AutomationProperties.AutomationId="CloseWorkspaceButton"
                        Width="40"
                        Height="36"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnCloseWorkspaceClicked"
                        ToolTipService.ToolTip="Back to reader">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="2">
                        <TextBlock
                            x:Name="PageWorkspaceTitle"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="PageWorkspaceSubtitle"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <ContentControl
                    x:Name="PageWorkspaceContent"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<Window
    x:Class="Openza.Reader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Openza Reader">
    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            IsOpen="False">
            <AppBarButton Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open Markdown file" Click="OnOpenClicked" />
            <AppBarButton Icon="Refresh" Label="Reload" ToolTipService.ToolTip="Reload current file" Click="OnReloadClicked" />
            <AppBarButton x:Name="TocButton" Icon="List" Label="Contents" ToolTipService.ToolTip="Show or hide contents" Click="OnToggleTocClicked" />
            <AppBarSeparator />
            <AppBarButton Icon="ZoomOut" Label="Zoom out" ToolTipService.ToolTip="Zoom out" Click="OnZoomOutClicked" />
            <AppBarButton Icon="ZoomIn" Label="Zoom in" ToolTipService.ToolTip="Zoom in" Click="OnZoomInClicked" />
            <AppBarSeparator />
            <AppBarButton Icon="Copy" Label="Copy" ToolTipService.ToolTip="Copy selected text" Click="OnCopyClicked" />
            <AppBarButton Icon="Edit" Label="Editor" ToolTipService.ToolTip="Open in external editor" Click="OnOpenExternalClicked" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="TocPane"
                Grid.Column="0"
                Visibility="Collapsed"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,14,16,10"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Contents" />
                    <ListView
                        x:Name="TocList"
                        Grid.Row="1"
                        Padding="8,0,8,12"
                        IsItemClickEnabled="True"
                        ItemClick="OnTocItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    FontSize="{Binding FontSize}"
                                    Margin="{Binding IndentMargin}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <WebView2 x:Name="ReaderWebView" />
                <Border
                    x:Name="EmptyState"
                    MaxWidth="520"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Openza Reader" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Text="Open a Markdown file to start reading." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

<UserControl
    x:Class="Openza.Reader.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AboutLinkButtonStyle" TargetType="HyperlinkButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        Padding="106,0,36,36"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1064"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="64"
                Height="64"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Image
                    Width="48"
                    Height="48"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-unplated.png" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="VersionText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="A native, read-only Markdown reader for Windows."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <HyperlinkButton
                    AutomationProperties.AutomationId="AboutDocumentationLink"
                    NavigateUri="https://openza.github.io/reader/"
                    Style="{StaticResource AboutLinkButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="32"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A5;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Documentation" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Read guides and release notes" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </HyperlinkButton>

                <HyperlinkButton
                    AutomationProperties.AutomationId="AboutSourceRepositoryLink"
                    Grid.Column="1"
                    NavigateUri="https://github.com/openza/reader"
                    Style="{StaticResource AboutLinkButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="32"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE943;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Source repository" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="View the project on GitHub" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </HyperlinkButton>

                <HyperlinkButton
                    AutomationProperties.AutomationId="AboutIssueLink"
                    Grid.Row="1"
                    NavigateUri="https://github.com/openza/reader/issues"
                    Style="{StaticResource AboutLinkButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="32"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7BA;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Report an issue" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Open bugs and feature requests" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </HyperlinkButton>

                <HyperlinkButton
                    AutomationProperties.AutomationId="AboutSecurityPolicyLink"
                    Grid.Row="1"
                    Grid.Column="1"
                    NavigateUri="https://github.com/openza/reader/blob/main/SECURITY.md"
                    Style="{StaticResource AboutLinkButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="32"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Security policy" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Report vulnerabilities responsibly" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </HyperlinkButton>

                <HyperlinkButton
                    AutomationProperties.AutomationId="AboutThirdPartyNoticesLink"
                    Grid.Row="2"
                    NavigateUri="https://github.com/openza/reader/blob/main/THIRD-PARTY-NOTICES.md"
                    Style="{StaticResource AboutLinkButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="32"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A5;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Third-party notices" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Licenses for bundled dependencies" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A7;" />
                    </Grid>
                </HyperlinkButton>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Openza Reader is licensed under the MIT License. Markdown files are treated as untrusted input; raw HTML remains disabled."
                TextWrapping="Wrap" />
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

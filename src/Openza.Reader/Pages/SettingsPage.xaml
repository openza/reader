<UserControl
    x:Class="Openza.Reader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,28,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        Padding="106,0,36,36"
        HorizontalScrollBarVisibility="Disabled"
        SizeChanged="OnSettingsSizeChanged"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="SettingsContent"
            MaxWidth="1064"
            HorizontalAlignment="Left"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Reading" />

            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="DefaultViewRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DefaultViewControlColumn" Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Default view" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose the view used when a file opens."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="DefaultViewCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="Preview" Tag="Preview" />
                        <ComboBoxItem Content="Raw" Tag="Raw" />
                        <ComboBoxItem Content="Side by side" Tag="SideBySide" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="ReaderThemeRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ReaderThemeControlColumn" Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE771;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Reader theme" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Affects rendered Markdown only; Windows High Contrast still wins."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ReaderThemeCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="System" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Sepia" Tag="Sepia" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="RemoteImagesRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RemoteImagesControlColumn" Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72E;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Remote images" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Block remote images for privacy, or allow them for README compatibility."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="RemoteImagesCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="Allow" Tag="Allow" />
                        <ComboBoxItem Content="Block" Tag="Block" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="StatsRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="StatsControlColumn" Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE9D2;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Document stats" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Show word count, estimated read time, and heading count in the title area."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StatsSwitch"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="OnSettingChanged" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Local data" />

            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="RecentFilesRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RecentFilesControlColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE823;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="RecentFilesCountText"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="No recent files" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Recent files stay local to this Windows account."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ClearRecentFilesButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="Clear"
                        Click="OnClearRecentFilesClicked" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

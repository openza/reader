<Window
    x:Class="Openza.Reader.Avalonia.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    Height="500"
    CanResize="False"
    ShowInTaskbar="False"
    Title="Reader settings"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="20">
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Choose how Markdown documents appear in Openza Reader." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,200" ColumnSpacing="20">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Application theme" />
                <TextBlock FontSize="12" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Follow the desktop or select a fixed theme." />
            </StackPanel>
            <ComboBox x:Name="ThemePicker" Grid.Column="1">
                <ComboBoxItem Content="System" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
                <ComboBoxItem Content="Sepia" Tag="Sepia" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,200" ColumnSpacing="20">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Default view" />
                <TextBlock FontSize="12" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Select the view used when a document opens." />
            </StackPanel>
            <ComboBox x:Name="ViewPicker" Grid.Column="1">
                <ComboBoxItem Content="Preview" Tag="Preview" />
                <ComboBoxItem Content="Raw Markdown" Tag="Raw" />
                <ComboBoxItem Content="Side by side" Tag="SideBySide" />
            </ComboBox>
        </Grid>

        <CheckBox x:Name="RemoteImagesCheckBox" Grid.Row="3" Content="Allow remote images in Markdown documents" />
        <StackPanel Grid.Row="4" Spacing="12">
            <CheckBox x:Name="DocumentStatsCheckBox" Content="Show document statistics" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Recent files" />
                    <TextBlock x:Name="RecentFilesCountText" FontSize="12" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnClearRecentFilesClicked" Content="Clear" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Click="OnCancelClicked" Content="Cancel" />
            <Button Click="OnSaveClicked" Content="Save" />
        </StackPanel>
    </Grid>
</Window>

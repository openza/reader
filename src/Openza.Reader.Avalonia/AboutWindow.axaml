<Window
    x:Class="Openza.Reader.Avalonia.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560"
    Height="480"
    CanResize="False"
    ShowInTaskbar="False"
    Title="About Openza Reader"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="72,*" ColumnSpacing="16">
            <Image Width="64" Height="64" Source="avares://Openza.Reader.Avalonia/Assets/reader.png" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Openza Reader" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="A cross-platform, read-only Markdown reader built with Avalonia." TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Spacing="8">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnDocumentationClicked" Content="Documentation" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSourceClicked" Content="Source repository" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnIssuesClicked" Content="Report an issue" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSecurityClicked" Content="Security policy" />
        </StackPanel>

        <Border Grid.Row="3" Padding="12" Background="{DynamicResource ThemeControlLowBrush}" CornerRadius="6">
            <TextBlock Text="Licensed under the MIT License. Markdown is treated as untrusted input; raw HTML remains disabled." TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>

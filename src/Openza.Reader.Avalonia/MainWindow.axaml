<Window
    x:Class="Openza.Reader.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1180"
    Height="760"
    MinWidth="720"
    MinHeight="480"
    Title="Openza Reader"
    Icon="avares://Openza.Reader.Avalonia/Assets/reader.png"
    DragDrop.AllowDrop="True"
    DragDrop.Drop="OnFilesDropped"
    KeyDown="OnWindowKeyDown">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Image Width="28" Height="28" Source="avares://Openza.Reader.Avalonia/Assets/reader.png" />
                <TextBlock
                    x:Name="DocumentTitle"
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Openza Reader"
                    TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Click="OnOpenClicked" Content="Open" />
                <Button Grid.Column="3" Click="OnSettingsClicked" Content="Settings" />
                <Button Grid.Column="4" Click="OnAboutClicked" Content="About" />
            </Grid>
        </Border>

        <Border x:Name="CommandBar" Grid.Row="1" Padding="16,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnReloadClicked" Content="Reload" />
                <ComboBox
                    x:Name="ViewModePicker"
                    Width="132"
                    SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="Preview" Tag="Preview" />
                    <ComboBoxItem Content="Raw Markdown" Tag="Raw" />
                    <ComboBoxItem Content="Side by side" Tag="SideBySide" />
                </ComboBox>
                <ToggleButton x:Name="TocToggle" Click="OnTocToggled" Content="Contents" />
                <TextBox
                    x:Name="FindTextBox"
                    Width="170"
                    PlaceholderText="Find in document"
                    KeyDown="OnFindTextKeyDown" />
                <Button Click="OnFindClicked" Content="Find" />
                <Button Click="OnZoomOutClicked" Content="Zoom −" />
                <Button Click="OnZoomInClicked" Content="Zoom +" />
                <Button Click="OnCopyClicked" Content="Copy" />
                <Button Click="OnOpenExternalClicked" Content="Editor" />
                <ToggleButton x:Name="FocusToggle" Click="OnFocusClicked" Content="Focus" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="MessageBar"
            Grid.Row="2"
            Margin="16,10,16,0"
            Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundAccentBrush}"
            CornerRadius="6"
            IsVisible="False">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="Auto,*">
            <Border
                x:Name="TocPane"
                Grid.Column="0"
                Width="260"
                Padding="16,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,1,0"
                IsVisible="False">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Contents" />
                    <ListBox x:Name="TocList" Grid.Row="1" SelectionChanged="OnTocSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="{Binding Margin}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="DocumentHost" ColumnDefinitions="*,Auto,*" IsVisible="False">
                    <TextBox
                        x:Name="RawMarkdown"
                        Grid.Column="0"
                        Padding="24"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono, DejaVu Sans Mono, monospace"
                        FontSize="14"
                        IsReadOnly="True"
                        TextWrapping="NoWrap" />
                    <GridSplitter x:Name="DocumentSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" />
                    <NativeWebView
                        x:Name="ReaderWebView"
                        Grid.Column="2"
                        EnvironmentRequested="OnWebViewEnvironmentRequested"
                        NavigationCompleted="OnWebViewNavigationCompleted"
                        NavigationStarted="OnWebViewNavigationStarted"
                        NewWindowRequested="OnWebViewNewWindowRequested" />
                </Grid>

                <Grid x:Name="EmptyState" Margin="48" RowDefinitions="*,Auto,Auto,Auto,*" RowSpacing="12">
                    <Image
                        Grid.Row="1"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Source="avares://Openza.Reader.Avalonia/Assets/reader.png" />
                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Openza Reader" />
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Open a Markdown file to start reading." />
                        <Button HorizontalAlignment="Center" Click="OnOpenClicked" Content="Open Markdown file" />
                        <ListBox
                            x:Name="RecentFilesList"
                            MinWidth="420"
                            MaxHeight="220"
                            DoubleTapped="OnRecentFileActivated" />
                    </StackPanel>
                </Grid>

                <Button
                    x:Name="FocusExitButton"
                    Margin="0,16,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OnExitFocusClicked"
                    Content="Exit focus"
                    IsVisible="False" />
            </Grid>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="4" Padding="16,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="FilePathText" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DocumentStatsText" Grid.Column="1" Margin="20,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>

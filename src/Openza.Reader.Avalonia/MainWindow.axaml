<Window
    x:Class="Openza.Reader.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
    xmlns:views="clr-namespace:Openza.Reader.Avalonia.Views"
    Width="1180"
    Height="760"
    MinWidth="720"
    MinHeight="480"
    Title="Openza Reader"
    Icon="avares://Openza.Reader/Assets/reader.png"
    WindowState="Maximized"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40"
    DragDrop.AllowDrop="True"
    DragDrop.Drop="OnFilesDropped"
    KeyDown="OnWindowKeyDown"
    SizeChanged="OnWindowSizeChanged">
    <Grid RowDefinitions="40,Auto,Auto,*">
        <Border
            x:Name="HeaderBar"
            Grid.Row="0"
            Background="{DynamicResource ThemeControlLowBrush}"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="160,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock
                    x:Name="DocumentTitle"
                    IsVisible="False"
                    Text="Openza Reader"
                    />
                <TextBlock
                    x:Name="DocumentStatsText"
                    Grid.Column="1"
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource ThemeForegroundLowBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border
            x:Name="CommandBar"
            Grid.Row="1"
            Padding="12,8"
            Background="{DynamicResource ThemeControlLowBrush}"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button Click="OnOpenClicked" Content="Open" ToolTip.Tip="Open Markdown file (Ctrl+O)" />
                    <Button Click="OnRecentClicked" Content="Recent" ToolTip.Tip="Show recent files" />
                    <Button Click="OnReloadClicked" Content="Reload" ToolTip.Tip="Reload current file" />
                    <ComboBox x:Name="ViewModePicker" Width="126" SelectionChanged="OnViewModeChanged" ToolTip.Tip="Document view mode">
                        <ComboBoxItem Content="Preview" Tag="Preview" />
                        <ComboBoxItem Content="Raw Markdown" Tag="Raw" />
                        <ComboBoxItem Content="Side by side" Tag="SideBySide" />
                    </ComboBox>
                    <ToggleButton x:Name="FocusToggle" Click="OnFocusClicked" Content="Focus" ToolTip.Tip="Toggle focus reading mode (F11)" />
                    <TextBox x:Name="FindTextBox" Width="154" PlaceholderText="Find in document" KeyDown="OnFindTextKeyDown" />
                    <Button Click="OnFindClicked" Content="Search" ToolTip.Tip="Find next match (Ctrl+F)" />
                    <ToggleButton x:Name="TocToggle" Click="OnTocToggled" Content="Contents" ToolTip.Tip="Show or hide contents" />
                    <Button Click="OnZoomOutClicked" Content="Zoom −" ToolTip.Tip="Zoom out" />
                    <Button Click="OnZoomInClicked" Content="Zoom +" ToolTip.Tip="Zoom in" />
                    <Button Click="OnCopyClicked" Content="Copy" ToolTip.Tip="Copy selected text" />
                    <Button Click="OnOpenExternalClicked" Content="Editor" ToolTip.Tip="Open with an installed editor" />
                    <Button Click="OnSettingsClicked" Content="Settings" ToolTip.Tip="Open settings" />
                    <Button Click="OnAboutClicked" Content="About" ToolTip.Tip="About Openza Reader" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="MessageBar"
            Grid.Row="2"
            Margin="16,8,16,0"
            Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundAccentBrush}"
            CornerRadius="6"
            IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Padding="8,2" Click="OnDismissMessageClicked" Content="Close" />
            </Grid>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <Border
                x:Name="TocPane"
                Grid.Column="0"
                Width="300"
                Padding="8,8,8,12"
                Background="{DynamicResource ThemeControlLowBrush}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,1,0"
                IsVisible="False">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock Margin="8,6,8,8" FontWeight="SemiBold" Text="Contents" />
                    <ListBox x:Name="TocList" Grid.Row="1" SelectionChanged="OnTocSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="{Binding Margin}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="DocumentHost" ColumnDefinitions="*,Auto,*" IsVisible="False">
                    <TextBox
                        x:Name="RawMarkdown"
                        Grid.Column="0"
                        Padding="24"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono, DejaVu Sans Mono, monospace"
                        FontSize="14"
                        IsReadOnly="True"
                        TextWrapping="NoWrap" />
                    <GridSplitter x:Name="DocumentSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" />
                    <html:HtmlPanel
                        x:Name="ReaderHtml"
                        Grid.Column="2"
                        Padding="24"
                        AvoidImagesLateLoading="False"
                        Focusable="True"
                        IsContextMenuEnabled="True"
                        IsSelectionEnabled="True" />
                </Grid>

                <views:ReaderEmptyView x:Name="EmptyState" />

                <Button
                    x:Name="FocusExitButton"
                    Margin="0,16,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OnExitFocusClicked"
                    Content="Exit focus"
                    IsVisible="False" />

                <Grid x:Name="PageWorkspace" Background="{DynamicResource ThemeControlLowBrush}" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Margin="36,20,36,12" ColumnDefinitions="52,*" ColumnSpacing="18">
                        <Button Width="40" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnCloseWorkspaceClicked" Content="←" ToolTip.Tip="Back to reader" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PageWorkspaceTitle" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="PageWorkspaceSubtitle" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ContentControl
                        x:Name="PageWorkspaceContent"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
